cat << 'EOF' > .gitignore
# Байткод и кэш Python
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения
.venv/
venv/
env/

# Секреты и конфигурация бота (токены)
.env
*.env
config.local.py

# Локальные базы данных
*.sqlite3
*.db

# Служебные файлы ОС и редакторов
.DS_Store
Thumbs.db
.idea/
.vscode/
EOF